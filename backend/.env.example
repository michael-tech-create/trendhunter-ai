# Gemini (agent reasoning)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Alpaca Trading API — paper keys only (PK...), not Broker CK... keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_CLI_PATH=alpaca

# App
DATABASE_URL=sqlite:///./trendhunter.db
WATCHLIST=AAPL,MSFT,F
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Risk gate
MIN_PREMIUM_RATIO=0.125
MAX_POSITION_CAPITAL=5000
MAX_PORTFOLIO_CAPITAL=50000
MAX_CONTRACTS_PER_DAY=3

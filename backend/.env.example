# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Alpaca (paper trading — use CLI profile or these for reference)
ALPACA_API_KEY=your_alpaca_paper_key
ALPACA_SECRET_KEY=your_alpaca_paper_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_CLI_PATH=alpaca

# App
DATABASE_URL=sqlite:///./trendhunter.db
WATCHLIST=AAPL,MSFT,SPY
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Risk gate defaults
MIN_PREMIUM_RATIO=0.125
MAX_POSITION_CAPITAL=5000
MAX_PORTFOLIO_CAPITAL=50000
MAX_CONTRACTS_PER_DAY=3

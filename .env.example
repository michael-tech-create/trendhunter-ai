# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://broker-api.sandbox.alpaca.markets
ALPACA_CLI_PATH=alpaca

# App
DATABASE_URL=sqlite:///./trendhunter.db
WATCHLIST=AAPL,MSFT,SPY
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Risk gate defaults
MIN_PREMIUM_RATIO=0.125
MAX_POSITION_CAPITAL=5000
MAX_PORTFOLIO_CAPITAL=50000
MAX_CONTRACTS_PER_DAY=3
